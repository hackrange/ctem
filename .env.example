# open-ctem environment configuration
# This file is a template. Run install.sh -- it generates a real .env automatically.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# These three are used by the db container AND the app.
# install.sh writes them all as a matched set.
DB_NAME=openctem
DB_USER=openctem
DB_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD  # nosec # noqa: S105

# Full connection URL for the app (password must match DB_PASSWORD above)
DATABASE_URL=postgresql+asyncpg://openctem:REPLACE_WITH_GENERATED_PASSWORD@db:5432/openctem

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD  # nosec # noqa: S105
REDIS_URL=redis://:REPLACE_WITH_GENERATED_PASSWORD@redis:6379/0

# ── Secrets ───────────────────────────────────────────────────────────────────
# All three must be 64 hex characters (= 32 bytes each).
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS  # nosec # noqa: S105
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS  # nosec # noqa: S105
ENCRYPTION_SEARCH_KEY=REPLACE_WITH_64_HEX_CHARS  # nosec # noqa: S105

# ── Backups ───────────────────────────────────────────────────────────────────
# Locks backups made with install.sh --backup (16+ characters). Keep a copy off
# this server, or a lost server takes the only way into its backups with it.
BACKUP_ENCRYPTION_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD  # nosec # noqa: S105
# Admin > Maintenance: set to false to allow restores from the command line only
# MAINTENANCE_UI_RESTORE=true
# MAINTENANCE_UPLOAD_MAX_GB=50

# ── First-boot admin user ─────────────────────────────────────────────────────
# Created automatically on first startup. Sign in, set a new password and enroll MFA, then clear
# INITIAL_ADMIN_PASS: if that username ever goes missing (renamed, or removed after moving to SSO),
# it is created again with this password.
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASS=REPLACE_WITH_GENERATED_PASSWORD  # nosec # noqa: S105

# ── Authentication ────────────────────────────────────────────────────────────
# Options: local_only | oidc_only | both
AUTH_MODE=local_only

# Require TOTP for all local accounts. Production: set to true once the first admin has enrolled
# (everyone else is walked through enrollment at their next sign-in).
MFA_REQUIRED=false

# ── OIDC (required when AUTH_MODE is oidc_only or both) ──────────────────────
#OIDC_ISSUER=https://auth.acme.example.com
#OIDC_CLIENT_ID=your-client-id
#OIDC_CLIENT_SECRET=your-client-secret  # nosec # noqa: S105
#OIDC_REDIRECT_URI=https://ctem.acme.example.com/auth/callback
#OIDC_SCOPES=openid profile email groups

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: CTEM's own https address. SSO redirects and on-prem shipper installers use it; also add its
# host name to ALLOWED_HOSTS (the browser origin check).
#PUBLIC_URL=https://ctem.acme.example.com
# Country assumed for directory phone numbers that have none of their own (ISO 3166 alpha-2)
#PHONE_DEFAULT_REGION=US
# Admin-style account prefixes that belong to a person, comma separated (sulocal_jdoe -> jdoe)
#ACCOUNT_ALIAS_PREFIXES=sulocal_

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# A browser session ends after this many hours, however active
#SESSION_MAX_HOURS=12
# A host no tool has seen in this many days, and that doesn't answer the network probe, loses its findings (7-365)
#STALE_HOST_DAYS=30
# A password an admin sets works this many hours before its first sign-in replaces it
#INITIAL_PASSWORD_HOURS=72
# Sign-in attempts allowed from one address per window
#IP_AUTH_MAX_ATTEMPTS=20
#IP_AUTH_WINDOW_SECONDS=600
# Off for an air-gapped server: no threat intel feeds (CISA KEV, EPSS and the like) are fetched
#THREAT_FEEDS_ENABLED=true
# Days of hunt telemetry kept
#HUNT_RETENTION_DAYS=30
# Where Admin > Maintenance finds the host agent's folders, and the disk Admin > Utilization watches
#MAINTENANCE_DIR=/srv/ctem
#CTEM_UTIL_DISK_PATH=/

# ── TOTP lockout thresholds ───────────────────────────────────────────────────
TOTP_LOCKOUT_THRESHOLD_1=5
TOTP_LOCKOUT_MINUTES_1=5
TOTP_LOCKOUT_THRESHOLD_2=10
TOTP_LOCKOUT_MINUTES_2=30
TOTP_LOCKOUT_THRESHOLD_3=15

# ── Email (smtp | ms365 | disabled) ──────────────────────────────────────────
EMAIL_MODE=disabled
#SMTP_HOST=smtp.acme.example.com
#SMTP_PORT=587
#SMTP_USERNAME=ctem-notify@acme.example.com
#SMTP_PASSWORD=your-smtp-password  # nosec # noqa: S105
#SMTP_FROM=ctem-notify@acme.example.com
#SMTP_TLS=true

# Microsoft 365 (EMAIL_MODE=ms365)
#MS365_TENANT_ID=your-tenant-id
#MS365_CLIENT_ID=your-app-client-id
#MS365_CLIENT_SECRET=your-app-client-secret  # nosec # noqa: S105
#MS365_FROM_ADDRESS=ctem-notify@acme.example.com
# The ServiceNow address tickets can be emailed to
#SERVICENOW_INBOUND_EMAIL=servicedesk@acme.example.com

# ── AI (Anthropic) ────────────────────────────────────────────────────────────
#AI_API_KEY=your-anthropic-api-key  # nosec # noqa: S105
#AI_MODEL=claude-haiku-5-5

# ── Ports ─────────────────────────────────────────────────────────────────────
# 80 and 443 on every address unless set. The installer sets these when 80 or 443 is already in use (a reverse
# proxy in front of open-ctem on this server): this server only, free ports instead.
#PUBLIC_BIND=127.0.0.1:
#HTTP_PORT=8080
#HTTPS_PORT=8443
#LB_PORT=8085

# ── Load balancer ─────────────────────────────────────────────────────────────
# Private IP the upstream LB reaches us on (port 8085). Unset = loopback only.
#LB_BIND_IP=192.0.2.10
# The load balancers' own addresses (comma separated IPs or CIDRs). Only these may set the client IP on :8085.
#LB_TRUSTED_IPS=192.0.2.21,192.0.2.22

# The reverse proxy whose X-Forwarded-For / X-Forwarded-Proto the app believes (a hostname; the image sets "nginx").
# Set it only if your proxy has another name; empty means no forwarded header is believed.
# TRUSTED_PROXY_HOST=nginx
