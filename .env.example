# open-ctem environment configuration
# Copy to .env and fill in real values. Never commit .env.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 16 + TimescaleDB (recommended)
DATABASE_URL=postgresql+asyncpg://openctem:changeme@db:5432/openctem

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Secrets (GENERATE REAL VALUES - these are examples only) ─────────────────
# nosec - example values, not real credentials
# noqa: S105
SECRET_KEY=EXAMPLE_REPLACE_THIS_32_BYTE_HEX_VALUE_NOT_REAL
ENCRYPTION_KEY=EXAMPLE_REPLACE_THIS_32_BYTE_HEX_VALUE_NOT_REAL
ENCRYPTION_SEARCH_KEY=EXAMPLE_REPLACE_32_BYTE_HEX_VALUE_NOT_REAL

# Generate real values with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Authentication mode ───────────────────────────────────────────────────────
# Options: oidc_only | local_only | both
AUTH_MODE=both

# MFA required for local accounts (true/false)
MFA_REQUIRED=true

# ── OIDC (required when AUTH_MODE is oidc_only or both) ──────────────────────
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=your-client-id-here
OIDC_CLIENT_SECRET=your-client-secret-here  # nosec # noqa: S105
OIDC_REDIRECT_URI=https://ctem.example.com/auth/callback
OIDC_SCOPES=openid profile email groups

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
ALLOWED_HOSTS=ctem.example.com,localhost

# Session TTL in minutes (access token) and days (refresh token)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── TOTP lockout thresholds ───────────────────────────────────────────────────
TOTP_LOCKOUT_THRESHOLD_1=5
TOTP_LOCKOUT_MINUTES_1=5
TOTP_LOCKOUT_THRESHOLD_2=10
TOTP_LOCKOUT_MINUTES_2=30
TOTP_LOCKOUT_THRESHOLD_3=15
