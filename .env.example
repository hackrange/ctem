# open-ctem environment configuration
# This file is a template. Run install.sh -- it generates a real .env automatically.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# These three are used by the db container AND the app.
# install.sh writes them all as a matched set.
DB_NAME=openctem
DB_USER=openctem
DB_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD  # nosec # noqa: S105

# Full connection URL for the app (password must match DB_PASSWORD above)
DATABASE_URL=postgresql+asyncpg://openctem:REPLACE_WITH_GENERATED_PASSWORD@db:5432/openctem

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD  # nosec # noqa: S105
REDIS_URL=redis://:REPLACE_WITH_GENERATED_PASSWORD@redis:6379/0

# ── Secrets ───────────────────────────────────────────────────────────────────
# All three must be 64 hex characters (= 32 bytes each).
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS  # nosec # noqa: S105
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS  # nosec # noqa: S105
ENCRYPTION_SEARCH_KEY=REPLACE_WITH_64_HEX_CHARS  # nosec # noqa: S105

# ── First-boot admin user ─────────────────────────────────────────────────────
# Created automatically on first startup. Seeder is idempotent -- safe to leave in.
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASS=REPLACE_WITH_GENERATED_PASSWORD  # nosec # noqa: S105

# ── Authentication ────────────────────────────────────────────────────────────
# Options: local_only | oidc_only | both
AUTH_MODE=local_only

# Require TOTP for all local accounts (set to true in production after onboarding)
MFA_REQUIRED=false

# ── OIDC (required when AUTH_MODE is oidc_only or both) ──────────────────────
#OIDC_ISSUER=https://auth.acme.example.com
#OIDC_CLIENT_ID=your-client-id
#OIDC_CLIENT_SECRET=your-client-secret  # nosec # noqa: S105
#OIDC_REDIRECT_URI=https://ctem.acme.example.com/auth/callback
#OIDC_SCOPES=openid profile email groups

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── TOTP lockout thresholds ───────────────────────────────────────────────────
TOTP_LOCKOUT_THRESHOLD_1=5
TOTP_LOCKOUT_MINUTES_1=5
TOTP_LOCKOUT_THRESHOLD_2=10
TOTP_LOCKOUT_MINUTES_2=30
TOTP_LOCKOUT_THRESHOLD_3=15

# ── Email (smtp | ms365 | disabled) ──────────────────────────────────────────
EMAIL_MODE=disabled
#SMTP_HOST=smtp.acme.example.com
#SMTP_PORT=587
#SMTP_USERNAME=ctem-notify@acme.example.com
#SMTP_PASSWORD=your-smtp-password  # nosec # noqa: S105
#SMTP_FROM=ctem-notify@acme.example.com
#SMTP_TLS=true

# Microsoft 365 (EMAIL_MODE=ms365)
#MS365_TENANT_ID=your-tenant-id
#MS365_CLIENT_ID=your-app-client-id
#MS365_CLIENT_SECRET=your-app-client-secret  # nosec # noqa: S105
#MS365_FROM_ADDRESS=ctem-notify@acme.example.com

# ── AI (Anthropic) ────────────────────────────────────────────────────────────
#AI_API_KEY=your-anthropic-api-key  # nosec # noqa: S105
#AI_MODEL=claude-haiku-5-5
